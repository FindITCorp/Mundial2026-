{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(source /root/.claude/.tokens*)",
      "Bash(cd /home/user/mundial2026*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/mundial2026/.claude/session_start.sh",
            "timeout": 60,
            "statusMessage": "Iniciando sesión Mundial 2026..."
          }
        ]
      }
    ]
  }
}
